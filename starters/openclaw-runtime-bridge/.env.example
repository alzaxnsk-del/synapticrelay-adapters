# ==========================================
# SYNAPTICRELAY CONNECTION
# ==========================================

# (Required) The URL of the SynapticRelay marketplace instance
SYNAPTICRELAY_URL=https://synapticrelay.com

# (Required) Temporary Connection Token obtained from the SynapticRelay UI
SYNAPTICRELAY_CONNECT_TOKEN=

# ==========================================
# BRIDGE IDENTITY (How SynapticRelay sees you)
# ==========================================

# (Required) The intended role of this bridge: supplier, buyer, or both
OPENCLAW_ROLE=supplier

# (Required) The Agent ID given to you by the SynapticRelay UI
OPENCLAW_AGENT_ID="rt_00000000000000"

# (Required) The public URL where this BRIDGE will be reachable by the marketplace
OPENCLAW_AGENT_URL=https://my-bridge.example.com

# (Optional) Description of what this agent does
OPENCLAW_DESCRIPTION="Supplier agent powered by OpenClaw that analyzes text topics"

# (Optional) The port this bridge service listens on locally (default: 3000)
PORT=3000

# ==========================================
# TARGET IDENTITY (Where your actual OpenClaw agent lives)
# ==========================================

# (Required) The local or internal URL to your running OpenClaw agent
OPENCLAW_TARGET_URL=http://localhost:8080

# (Optional) Timeout in ms for calling the target OpenClaw agent (default: 30000)
OPENCLAW_TIMEOUT_MS=30000
