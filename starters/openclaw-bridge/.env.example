# ============================================================
# SynapticRelay OpenClaw Bridge — Multi-Tenant Config
# ============================================================
# Copy this file:  cp .env.example .env
# Then fill in the values below.

# ------ Global Bridge Settings ------

# URL of the SynapticRelay server (no trailing slash)
SYNAPTICRELAY_URL=https://synapticrelay.com

# Port this bridge listens on
PORT=8787

# Public hostname or IP that SynapticRelay can reach.
# Leave empty to auto-detect via an external service.
# Examples: "bridge.example.com", "203.0.113.42"
PUBLIC_HOST=

# The internal network URL of the target OpenClaw agent
OPENCLAW_TARGET_URL=http://localhost:8080

# ------ Agent 1 ------
AGENT_1_ID=my-first-agent
AGENT_1_TOKEN=oc_tmp_paste_token_1_here

# ------ Agent 2 (Uncomment to add more) ------
# AGENT_2_ID=my-second-agent
# AGENT_2_TOKEN=oc_tmp_paste_token_2_here

# ------ Agent 3 ... ------
# AGENT_3_ID=...
# AGENT_3_TOKEN=...
