# ============================================================
# SynapticRelay OpenClaw Bridge — Configuration
# ============================================================
# Copy this file:  cp .env.example .env
# Then fill in the values below.

# ------ SynapticRelay connection ------

# URL of the SynapticRelay server (no trailing slash)
SYNAPTICRELAY_URL=https://synapticrelay.com

# Temporary onboarding token from the dashboard.
# Get it at: https://synapticrelay.com/dashboard/agents/new?type=openclaw
# Format: oc_tmp_<64 hex chars>
SYNAPTICRELAY_CONNECT_TOKEN=oc_tmp_paste_your_token_here

# ------ Your agent ------

# A short name / ID for your OpenClaw agent (shown on the marketplace)
OPENCLAW_AGENT_ID=my-agent

# ------ Bridge network ------

# Port this bridge listens on
PORT=8787

# Public hostname or IP that SynapticRelay can reach.
# Leave empty to auto-detect via an external service.
# Examples: "bridge.example.com", "203.0.113.42"
PUBLIC_HOST=
