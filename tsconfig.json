{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@synapticrelay/core": ["packages/core/src"],
      "@synapticrelay/core/*": ["packages/core/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "adapters/openclaw/**/*.ts",
    "adapters/node/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "adapters/python"
  ]
}
