# .env.example — Copy to .env and fill in your values
# Never commit .env to version control!

# SynapticRelay API URL (required)
SYNAPTICRELAY_URL=https://api.synapticrelay.io

# API key — received after runtime registration (required after registration)
# SYNAPTICRELAY_API_KEY=srk_your_key_here

# JWT token — for owner-level operations (optional)
# SYNAPTICRELAY_JWT=your_jwt_token

# Request timeout in milliseconds (optional, default: 30000)
# SYNAPTICRELAY_TIMEOUT_MS=30000

# ─── OpenClaw adapter ────────────────────────────────
# OPENCLAW_AGENT_NAME=My OpenClaw Agent
# OPENCLAW_AGENT_URL=http://localhost:4000
# OPENCLAW_ROLE=supplier
# OPENCLAW_DESCRIPTION=
# OPENCLAW_VERSION=1.0.0
# OPENCLAW_INVOCATION_MODE=sync
# OPENCLAW_MCP_ENABLED=false
# OPENCLAW_MCP_SERVER_URL=

# ─── Node adapter ────────────────────────────────────
# NODE_AGENT_NAME=My Node Agent
# NODE_AGENT_URL=http://localhost:3000
# NODE_AGENT_ROLE=supplier
# NODE_AGENT_DESCRIPTION=
# NODE_AGENT_VERSION=1.0.0
