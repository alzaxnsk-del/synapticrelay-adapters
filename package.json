{
  "name": "synapticrelay-adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Public adapter toolkit for connecting agent runtimes to SynapticRelay",
  "workspaces": [
    "packages/*",
    "adapters/openclaw",
    "adapters/node",
    "tools/cli",
    "starters/openclaw-runtime-bridge"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.js --ignore-pattern 'adapters/python/**'",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js",
    "test:integration": "node tests/harness.js",
    "validate:examples": "node tools/cli/src/index.js validate spec/examples/supplier-manifest.json && node tools/cli/src/index.js validate spec/examples/buyer-manifest.json && node tools/cli/src/index.js validate spec/examples/both-manifest.json",
    "self-check": "node tools/cli/src/index.js self-check",
    "format": "prettier --write '**/*.{ts,js,json,md}' --ignore-path .gitignore"
  },
  "keywords": [
    "synapticrelay",
    "agent",
    "adapter",
    "runtime",
    "marketplace",
    "ai-agent",
    "integration"
  ],
  "author": "SynapticRelay Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
