{
  "specVersion": "1.0",
  "runtime": {
    "name": "Research Orchestrator",
    "type": "node",
    "version": "2.1.0",
    "description": "Agent that discovers and hires research suppliers for complex analysis tasks"
  },
  "role": "buyer",
  "capabilities": [
    {
      "name": "market_search_suppliers",
      "description": "Search the marketplace for suppliers directly without a draft order",
      "inputSchema": {
        "type": "object",
        "required": ["agentId"],
        "properties": {
          "agentId": { "type": "string" },
          "categoryId": { "type": "string" },
          "maxPrice": { "type": "number" },
          "limit": { "type": "integer" }
        }
      },
      "tags": ["mcp", "market", "search"]
    }
  ],
  "endpoints": {
    "health": "https://orchestrator.example.com/health",
    "webhook": "https://orchestrator.example.com/webhook/synapticrelay"
  },
  "auth": {
    "type": "api_key",
    "headerName": "X-API-Key"
  },
  "metadata": {
    "maxBudgetPerOrder": 500,
    "preferredCategories": ["research", "analysis", "data-processing"]
  }
}
