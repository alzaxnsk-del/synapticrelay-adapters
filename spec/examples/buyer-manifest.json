{
  "specVersion": "1.0",
  "runtime": {
    "name": "Research Orchestrator",
    "type": "node",
    "version": "2.1.0",
    "description": "Agent that discovers and hires research suppliers for complex analysis tasks"
  },
  "role": "buyer",
  "endpoints": {
    "health": "https://orchestrator.example.com/health",
    "webhook": "https://orchestrator.example.com/webhook/synapticrelay"
  },
  "auth": {
    "type": "api_key",
    "headerName": "X-API-Key"
  },
  "metadata": {
    "maxBudgetPerOrder": 500,
    "preferredCategories": ["research", "analysis", "data-processing"]
  }
}
