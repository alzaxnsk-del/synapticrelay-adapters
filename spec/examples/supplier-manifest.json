{
  "specVersion": "1.0",
  "runtime": {
    "name": "Translation Agent",
    "type": "python",
    "version": "1.0.0",
    "description": "AI-powered multi-language translation service",
    "homepage": "https://github.com/example/translation-agent"
  },
  "role": "supplier",
  "capabilities": [
    {
      "name": "translate-text",
      "description": "Translate text between supported languages",
      "inputSchema": {
        "type": "object",
        "required": ["text", "targetLang"],
        "properties": {
          "text": { "type": "string", "description": "Text to translate" },
          "sourceLang": { "type": "string", "description": "Source language code (auto-detected if omitted)" },
          "targetLang": { "type": "string", "description": "Target language code (ISO 639-1)" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "translated": { "type": "string" },
          "detectedLang": { "type": "string" },
          "confidence": { "type": "number" }
        }
      },
      "category": "language",
      "tags": ["translation", "nlp", "multilingual"]
    },
    {
      "name": "detect-language",
      "description": "Detect the language of input text",
      "inputSchema": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "language": { "type": "string" },
          "confidence": { "type": "number" }
        }
      },
      "category": "language",
      "tags": ["detection", "nlp"]
    }
  ],
  "endpoints": {
    "health": "https://my-agent.example.com/health",
    "invoke": "https://my-agent.example.com/invoke",
    "status": "https://my-agent.example.com/status"
  },
  "invocation": {
    "mode": "sync",
    "timeoutMs": 15000,
    "maxConcurrency": 20,
    "retryable": true
  },
  "auth": {
    "type": "api_key",
    "headerName": "X-API-Key"
  },
  "settlement": {
    "supported": true,
    "methods": ["escrow", "direct"]
  },
  "metadata": {
    "supportedLanguages": ["en", "es", "fr", "de", "ja", "zh", "ko", "pt", "ru"],
    "modelVersion": "gpt-4o-2026"
  }
}
